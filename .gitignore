# Carpetas que empiezan con punto (.venv, .codex, .aws, .ruff_cache...), en cualquier nivel.
.*/

# Documentación local (enunciados y diseño): no se sube.
/docs/

.venv

__pycache__/
os
sys
.python-version
historial_busqueda_dijkstra.csv
historial_entrenamiento.csv
progreso_entrenamiento.png
.pytest_cache/

# Todo lo que generan los skills y run_cgra.py: IR, graficas, horarios de los
# PEs, memorias y reportes (en cgra/programas/). En el repositorio solo queda
# el codigo fuente (.py, .c, .h) y la documentacion (.md).
*.ll
*.dot
*.json
*.bin
*.out
*.txt
pe_instructions/
graphs/
**/programas/*

# Excepciones: el formato de la CGRA (lo leen Python y los skills) y los
# datos de prueba
!**/src/cgra.json
!sistema2_greedy/config/*.json
!**/test/datos/**
# ...pero los .txt de test/datos no se suben
**/test/datos/**/*.txt

# Ciclo RL: la configuración de corridas se sube; las corridas generadas no.
!rl/config/*.json
resultados/corridas/

# Todo lo que no es código: resultados de corridas (en cualquier nivel),
# logs, imágenes, animaciones, documentos generados y tablas de datos.
resultados/
*.log
*.png
*.gif
*.jpg
*.jpeg
*.svg
*.pdf
*.csv
*.jsonl
*.pkl
*.npy
*.npz
*.aux
*.synctex.gz
